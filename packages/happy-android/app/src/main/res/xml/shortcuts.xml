<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts. Recent sessions are dynamic (assist/CompanionInbox.kt SessionShortcuts). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new-task"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_new_task_short"
        android:shortcutLongLabel="@string/shortcut_new_task_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="happy://new" />
    </shortcut>
</shortcuts>
