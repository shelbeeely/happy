# Copy to .env (never commit it). Every value is optional.

# OpenRouter key; profiles then use the credential "Environment variable" OPENROUTER_API_KEY.
# Leave empty to store a key from the phone instead (kept in the /data volume).
OPENROUTER_API_KEY=

# GitHub token for cloning and pushing (a fine-grained token limited to the repositories you want).
GITHUB_TOKEN=

# Repositories cloned into /workspace on first boot (space-separated).
REPOS=

# Identity for commits the agent makes.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# A self-hosted Happy server instead of the default.
# HAPPY_SERVER_URL=https://happy.example.com
